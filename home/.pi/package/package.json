{
  "name": "@blntrsz/pi-config",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal reusable resources for Pi",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "extensions",
    "themes"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test tests/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/subagent/index.ts",
      "./extensions/footer.ts",
      "./extensions/transcript-style.ts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "dependencies": {
    "jiti": "2.7.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "typebox": "1.3.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
